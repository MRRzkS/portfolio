# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key. Safe in a client bundle: row level security is what
# restricts it, not secrecy. The service role key must never appear here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://rienchy-razak.vercel.app

# Shared secret for the on-demand revalidation endpoint (slice 3).
REVALIDATE_SECRET=
